#include "main.h"
#include "ir.h"

uint32_t last_time = 0;
uint32_t now = 0;

int main(void)
{

  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_TIM2_Init();

  HAL_TIM_Base_Start(&htim2);

  while (1)
  {

    if(ir_received)
    {

      switch(ir_code)
      {

        case 0xFFA25D:   // bouton 1

          HAL_GPIO_WritePin(GPIOB,
          GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_10 | GPIO_PIN_11,
          GPIO_PIN_SET);

        break;

        case 0xFF629D:   // bouton 2

          HAL_GPIO_WritePin(GPIOB,
          GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_10 | GPIO_PIN_11,
          GPIO_PIN_RESET);

        break;

        case 0xFFE21D:   // bouton 3

          HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_0);

        break;

        case 0xFF22DD:   // bouton 4

          HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_1);

        break;

        case 0xFF02FD:   // bouton 5

          HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_10);

        break;

      }

      ir_received = 0;

    }

  }

}
